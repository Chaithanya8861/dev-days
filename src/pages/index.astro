---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const publisherOptions = await getAllPublishers(getDatabase());
const categories = [...new Map(
  games
    .filter((game) => game.category)
    .map((game) => [game.category?.id, game.category]),
)].map(([, category]) => category).filter((category): category is NonNullable<typeof category> => category !== undefined);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <a
          href="/"
          data-testid="clear-filters"
          class="text-sm text-blue-400 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500 rounded"
        >
          Clear filters
        </a>
      </div>

      <form data-testid="game-filters" class="mb-8 grid gap-6 rounded-xl border border-slate-700 bg-slate-800/60 p-6 sm:grid-cols-2">
        <fieldset>
          <legend class="mb-3 text-sm font-semibold text-slate-100">Filter by category</legend>
          <div class="grid gap-2">
            {categories.map((category) => (
              <label class="flex items-center gap-2 text-sm text-slate-300">
                <input
                  type="checkbox"
                  name="category"
                  value={category.id}
                  data-testid={`category-filter-${category.id}`}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend class="mb-3 text-sm font-semibold text-slate-100">Filter by publisher</legend>
          <div class="grid gap-2">
            <label class="flex items-center gap-2 text-sm text-slate-300">
              <input
                type="radio"
                name="publisher"
                value=""
                checked
                data-testid="publisher-filter-all"
                class="h-4 w-4 border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
              />
              <span>All publishers</span>
            </label>
            {publisherOptions.map((publisher) => (
              <label class="flex items-center gap-2 text-sm text-slate-300">
                <input
                  type="radio"
                  name="publisher"
                  value={publisher.id}
                  data-testid={`publisher-filter-${publisher.id}`}
                  class="h-4 w-4 border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                />
                <span>{publisher.name}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </form>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
      </div>
      <div hidden data-testid="filtered-empty-state">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const params = new URLSearchParams(window.location.search);

  function applyFilters(updateUrl = false) {
    const selectedCategories = [...document.querySelectorAll<HTMLInputElement>('input[name="category"]:checked')]
      .map((input) => input.value);
    const selectedPublisher = document.querySelector<HTMLInputElement>('input[name="publisher"]:checked')?.value ?? '';

    if (updateUrl) {
      const nextParams = new URLSearchParams();
      selectedCategories.forEach((category) => nextParams.append('category', category));
      if (selectedPublisher) nextParams.set('publisher', selectedPublisher);
      const query = nextParams.toString();
      window.history.replaceState({}, '', query ? `/?${query}` : '/');
    }

    let visibleCount = 0;
    cards.forEach((card) => {
      const matchesCategory = selectedCategories.length === 0 || selectedCategories.includes(card.dataset.categoryId ?? '');
      const matchesPublisher = !selectedPublisher || card.dataset.publisherId === selectedPublisher;
      const visible = matchesCategory && matchesPublisher;
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    });
    if (emptyState) emptyState.hidden = visibleCount > 0;
  }

  params.getAll('category').forEach((category) => {
    const input = document.querySelector<HTMLInputElement>(`input[name="category"][value="${CSS.escape(category)}"]`);
    if (input) input.checked = true;
  });
  const publisher = params.get('publisher');
  if (publisher) {
    const input = document.querySelector<HTMLInputElement>(`input[name="publisher"][value="${CSS.escape(publisher)}"]`);
    if (input) input.checked = true;
  }

  form?.addEventListener('change', () => applyFilters(true));
  applyFilters();
</script>
